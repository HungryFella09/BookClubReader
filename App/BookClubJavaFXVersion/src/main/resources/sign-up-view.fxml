<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="337.0" prefWidth="313.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.SignUpController">

    <PasswordField fx:id="passwordField" layoutX="87.0" layoutY="133.0" promptText="Password" />
    <PasswordField fx:id="retypePasswordField" layoutX="87.0" layoutY="176.0" promptText="Retype Password" />
    <TextField fx:id="usernameField" layoutX="87.0" layoutY="94.0" promptText="Username" />
    <Button layoutX="127.0" layoutY="276.0" mnemonicParsing="false" onAction="#onSignUp" text="Sign Up" />
    <TextField fx:id="emailField" layoutX="87.0" layoutY="216.0" promptText="Email" />
    <Label fx:id="errorLabel" layoutX="88.0" layoutY="250.0" prefHeight="18.0" prefWidth="150.0" textFill="RED" />
   <Label layoutX="124.0" layoutY="42.0" text="Sign Up">
      <font>
         <Font size="18.0" />
      </font>
   </Label>

</AnchorPane>
