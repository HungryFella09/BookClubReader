<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="336.0" prefWidth="318.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.LogInController">
   <children>
      <PasswordField fx:id="passwordField" layoutX="87.0" layoutY="133.0" promptText="Password" />
      <TextField fx:id="usernameField" layoutX="87.0" layoutY="94.0" promptText="Username" />
      <Button layoutX="108.0" layoutY="201.0" mnemonicParsing="false" onAction="#onLogIn" prefHeight="26.0" prefWidth="100.0" text="Log In" />
      <Label layoutX="58.0" layoutY="247.0" text="Don't have an account? Then Sign Up:" />
      <Label layoutX="117.0" layoutY="33.0" text="Log In">
         <font>
            <Font size="30.0" />
         </font>
      </Label>
      <Button layoutX="130.0" layoutY="283.0" mnemonicParsing="false" onAction="#onSignUp" text="Sign Up" />
      <Label fx:id="errorLabel" layoutX="86.0" layoutY="170.0" prefHeight="18.0" prefWidth="150.0" textFill="RED" />
   </children>
</AnchorPane>
